{
  "auth": {
    "providers": {
      "anonymous": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Öv Chronicles",
        "supportEmail": "enkhjin@geret.mn"
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "ov-backend",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "test",
        "*.log",
        ".env.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "app/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
